const Avatar_Photo =
  'https://pvbcyuflhlucnmcnlgfh.supabase.co/storage/v1/object/public/avatars/d30e44ea-4558-40d6-a3ef-b05ead808f06/avatar.png';

const externalLinks = [
  { label: 'Portfolio', href: PORTFOLIO_URL },
