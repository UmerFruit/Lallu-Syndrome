@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    /* Dark theme (default) */
    --color-bg: #090909;
    --color-surface: #111111;
    --color-elevated: #171717;
    --color-border: #292929;
    --color-border-subtle: #1e1e1e;
    --color-text-primary: #F4F4F4;
    --color-text-secondary: #A0A0A0;
    --color-text-muted: #707070;
    --color-accent: #B00000;
    --color-accent-hover: #C20A0A;
  }

  .light {
    --color-bg: #F7F7F5;
    /* Main page: soft warm off-white */
    --color-surface: #F0F0ED;
    /* Cards/sections: subtle contrast */
    --color-elevated: #FFFFFF;
    /* Only elevated elements needing separation */

    --color-border: #D9D9D5;
    --color-border-subtle: #E8E8E4;

    --color-text-primary: #181818;
    /* Nearly black, less harsh */
    --color-text-secondary: #626262;
    --color-text-muted: #8A8A8A;

    --color-accent: #9E0000;
    --color-accent-hover: #B00000;
  }

  * {
    border-color: var(--color-border);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--color-bg);
    color: var(--color-text-primary);
    font-family: 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 200ms ease, color 200ms ease;
  }

  ::selection {
    background-color: var(--color-accent);
    color: #ffffff;
  }

  /* Focus visible */
  *:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--color-bg);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-text-muted);
  }
}

@layer components {
  .article-prose {
    @apply text-text-secondary leading-[1.75] text-[1.125rem];
  }

  .article-prose {
    @apply text-text-secondary leading-[1.7] text-base sm:leading-[1.75] sm:text-[1.125rem];
  }

  .article-prose p {
    @apply my-4 sm:my-5;
  }

  .article-prose h1 {
    @apply font-serif text-2xl sm:text-3xl md:text-4xl font-medium text-text-primary mt-8 sm:mt-12 mb-4 leading-[1.2] tracking-tight;
  }

  .article-prose h2 {
    @apply font-serif text-xl sm:text-2xl md:text-3xl font-medium text-text-primary mt-8 sm:mt-10 mb-3 leading-[1.25] tracking-tight;
  }

  .article-prose h3 {
    @apply font-serif text-lg sm:text-xl md:text-2xl font-medium text-text-primary mt-6 sm:mt-8 mb-2 leading-[1.3] tracking-tight;
  }

  .article-prose blockquote {
    @apply my-5 sm:my-6 pl-4 sm:pl-5 border-l-2 border-accent text-text-primary italic font-serif text-base sm:text-lg leading-relaxed;
  }

  .article-prose .ProseMirror p {
    position: relative;
  }

  .article-prose a {
    @apply text-text-primary underline decoration-accent decoration-2 underline-offset-2 hover:text-accent transition-colors duration-200;
  }

  .article-prose strong {
    @apply font-semibold text-text-primary;
  }

  .article-prose em {
    @apply italic;
  }

  .article-prose del {
    @apply text-text-muted;
  }

  .article-prose ul {
    @apply my-5 pl-6 list-disc space-y-2;
  }

  .article-prose ol {
    @apply my-5 pl-6 list-decimal space-y-2;
  }

  .article-prose li {
    @apply text-text-secondary;
  }

  .article-prose code {
    @apply font-mono text-[0.875em] px-1.5 py-0.5 rounded bg-elevated text-text-primary;
  }

  .article-prose pre {
    @apply my-6 rounded-card overflow-hidden;
  }

  .article-prose pre code {
    @apply bg-transparent p-0 text-sm;
  }

  .article-prose img {
    @apply block rounded-card my-6 max-w-full h-auto;
  }

  .article-prose table {
    @apply my-6 w-full border-collapse text-sm;
  }

  .article-prose th {
    @apply text-left font-semibold text-text-primary border border-border px-4 py-2.5 bg-surface;
  }

  .article-prose td {
    @apply text-text-secondary border border-border px-4 py-2.5;
  }

  .article-prose hr {
    @apply my-10 border-border;
  }

  .tiptap-code-block {
    @apply my-6 overflow-hidden rounded-card border border-border bg-elevated;
  }

  .tiptap-code-block__header {
    @apply flex items-center justify-between border-b border-border bg-surface px-3 py-2;
  }

  .tiptap-code-block__language {
    @apply bg-transparent text-xs font-mono text-text-secondary outline-none;
  }

  .tiptap-code-block__actions {
    @apply flex items-center gap-1;
  }

  .tiptap-code-block__action {
    @apply inline-flex items-center justify-center rounded p-1.5 text-text-muted transition-colors duration-200 hover:bg-elevated hover:text-text-primary;
  }

  .tiptap-code-block__action--danger {
    @apply hover:text-accent;
  }

  .tiptap-code-block__content {
    @apply overflow-x-auto p-4 font-mono text-sm leading-relaxed text-text-primary;
  }

  .tiptap-code-block__content .ProseMirror {
    @apply m-0 min-h-0 bg-transparent p-0 outline-none font-mono text-sm text-text-primary;
  }

}
.tiptap-code-block__action {
  @apply inline-flex items-center justify-center rounded p-2.5 text-text-muted transition-colors duration-200 hover:bg-elevated hover:text-text-primary;
}

/* ── AboutPage animations ─────────────────────────────── */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.anim-fade-up {
  opacity: 0;
  animation: fadeUp 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
}

@keyframes blink {

  0%,
  50% {
    opacity: 1;
  }

  51%,
  100% {
    opacity: 0;
  }
}

.anim-blink {
  animation: blink 1.1s steps(1) infinite;
}

@keyframes rotateGradient {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.avatar-ring::before {
  content: "";
  position: absolute;
  inset: -3px;
  border-radius: 9999px;
  background: conic-gradient(from 0deg,
      transparent 0deg,
      rgba(220, 38, 38, 0.9) 40deg,
      transparent 90deg,
      transparent 360deg);
  animation: rotateGradient 6s linear infinite;
  z-index: 0;
}

.avatar-ring>img {
  position: relative;
  z-index: 1;
}

@keyframes marquee {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

.anim-marquee {
  animation: marquee 35s linear infinite;
}

.marquee-mask {
  mask-image: linear-gradient(to right, transparent 0, black 80px, black calc(100% - 80px), transparent 100%);
  -webkit-mask-image: linear-gradient(to right, transparent 0, black 80px, black calc(100% - 80px), transparent 100%);
}

.link-underline {
  position: relative;
}

.link-underline::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -2px;
  height: 1px;
  width: 100%;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: right center;
  transition: transform 450ms cubic-bezier(0.7, 0, 0.2, 1);
}

.link-underline:hover::after {
  transform: scaleX(1);
  transform-origin: left center;
}

@keyframes wipe {
  from {
    clip-path: inset(0 100% 0 0);
  }

  to {
    clip-path: inset(0 0 0 0);
  }
}

.anim-wipe {
  animation: wipe 1.2s cubic-bezier(0.7, 0, 0.2, 1) both;
}

.grain::after {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.035;
  z-index: 1;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
}

.anim-arrow {
  transition: transform 350ms ease;
}

.link-underline:hover .anim-arrow {
  transform: translate(2px, -2px);
}

.avatar-hover {
  transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 500ms ease;
}

.avatar-hover:hover {
  transform: scale(1.03);
  box-shadow: 0 0 0 1px rgba(220, 38, 38, 0.4), 0 20px 40px -10px rgba(220, 38, 38, 0.15);
}

@layer utilities {
  .text-balance {
    text-wrap: balance;
  }

  .text-pretty {
    text-wrap: pretty;
  }
}
.group:hover .link-underline::after {
  transform: scaleX(1);
  transform-origin: left center;
}
/* Oval portrait — the house avatar shape (4:5, egg-framed) */
.avatar {
  aspect-ratio: 4 / 5;
  border-radius: 9999px;
  object-fit: cover;
  object-position: center;
}

/* Tiptap borderless, page-flush */
.ProseMirror {
  outline: none;
}

.ProseMirror p.is-editor-empty:first-child::before {
  content: attr(data-placeholder);
  float: left;
  height: 0;
  pointer-events: none;
  color: var(--color-text-muted);
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
